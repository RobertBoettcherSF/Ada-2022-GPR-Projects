with "greeter.gpr";

project App is
   for Source_Dirs use ("src/app");
   for Object_Dir  use "obj/app";
   for Exec_Dir    use "bin";
   for Main        use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;

   package Builder is
      for Executable ("main.adb") use "greeter_app";
   end Builder;
end App;
