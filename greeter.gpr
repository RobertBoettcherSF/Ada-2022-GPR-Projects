library project Greeter is
   for Source_Dirs use ("src/lib");
   for Object_Dir  use "obj/lib";
   for Library_Name use "greeter";
   for Library_Dir  use "lib";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;
end Greeter;
